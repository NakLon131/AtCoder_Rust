{
  "matpow": {
    "prefix": "matpow",
    "body": [
      "// 行列計算(行列a,bがともに正方形)",
      "// 例 2*2同士の行列",
      "pub fn mat_square_permutation(",
      "	a: &Vec<Vec<usize>>,",
      "	b: &Vec<Vec<usize>>,",
      "	sz: usize,",
      "	mods: usize,",
      ") -> Vec<Vec<usize>> {",
      "	let mut ret = vec![vec![0usize; sz]; sz];",
      "	for i in 0..sz {",
      "		for j in 0..sz {",
      "			for k in 0..sz {",
      "				ret[i][j] += a[i][k] * b[k][j];",
      "				ret[i][j] %= mods;",
      "			}",
      "		}",
      "	}",
      "	ret",
      "}",
      "// 行列計算(aが行列、bがベクトル)",
      "// 例 3*3の行列 × 要素3のベクトル",
      "pub fn mat_vector_permutation(",
      "	a: &Vec<Vec<usize>>,",
      "	b: &Vec<usize>,",
      "	sz_a: usize,",
      "	mods: usize,",
      ") -> Vec<usize> {",
      "	let mut ret = vec![0usize; sz_a];",
      "	for i in 0..sz_a {",
      "		for j in 0..sz_a {",
      "			ret[i] += a[i][j] * b[j];",
      "			ret[i] %= mods;",
      "		}",
      "	}",
      "	ret",
      "}",
      "",
      "// 行列累乗",
      "fn mat_pow(a: &Vec<Vec<usize>>, mut b: usize, sz: usize, mods: usize) -> Vec<Vec<usize>> {",
      "  let mut c = a.clone();",
      "  let mut ret = vec![vec![0usize; sz]; sz];",
      "  for i in 0..sz {ret[i][i] = 1;}	// 単位行列で初期化",
      "  while b > 0 {",
      "	  if b % 2 != 0 {",
      "		  ret = mat_square_permutation(&ret, &c, sz, mods);",
      "	  }",
      "	  c = mat_square_permutation(&c, &c, sz, mods);",
      "	  b >>= 1;",
      "  }",
      "  ret",
      "}",
    ]
  }
}
