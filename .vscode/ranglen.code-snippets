{
  "ranglen": {
    "prefix": "ranglen",
    "body": [
      "// ランレングス圧縮"
      "pub fn ranglen(arr: &Vec<char>) -> Vec<(char, usize)> {",
      "    let len = arr.len();",
      "    let mut arr_ret = Vec::new();",
      "    let mut tail = 0;",
      "    let mut top = 0;",
      "    while tail < len {",
      "        let now_c = arr[tail];",
      "        while top < len && now_c == arr[top] {",
      "            top += 1;",
      "        }",
      "        arr_ret.push((now_c, top - tail));",
      "        tail = top;",
      "    }",
      "    arr_ret",
      "}"
    ]
  }
}
