{
  "rolling_hash": {
    "prefix": "rolling_hash",
    "body": [
      "// ローリングハッシュ",
      "const HASH_MOD: usize = 1499122213;",
      "",
      "struct RollingHash {",
      "    power: Vec<usize>,      // 100の累乗 mod HASH_MOD",
      "    hash_values: Vec<usize>,// 先頭からの累積ハッシュ値",
      "    rev_hash_values: Vec<usize>,// 末尾からの累積ハッシュ値",
      "}",
      "",
      "impl RollingHash {",
      "    // 与えられた文字列 `s` からローリングハッシュを構築する。",
      "    // `is_upper` が true の場合、'A' を 1, 'B' を 2, …, 'Z' を 26 として扱う。",
      "    fn new(s: &Vec<char>, is_upper: bool) -> Self {",
      "        let n = s.len();",
      "        let mut rev_s = s.clone(); rev_s.reverse();",
      "",
      "        // 100の累乗を事前計算",
      "        let power = Self::__calc_power100(n);",
      "        // 元の文字列のハッシュ値計算",
      "        let hash_values = Self::__calc_hash_value_str(n, &s, is_upper);",
      "        // 反転文字列のハッシュ値計算",
      "        let rev_hash_values = Self::__calc_hash_value_str(n, &rev_s, is_upper);",
      "        ",
      "        Self { power, hash_values, rev_hash_values }",
      "    }",
      "",
      "    fn __calc_power100(n: usize) -> Vec<usize>{",
      "        let mut power = vec![1; n+1];",
      "        for i in 0..n {",
      "            power[i + 1] = power[i] * 100 % HASH_MOD;",
      "        }",
      "        power",
      "    }",
      "",
      "    fn __calc_hash_value_str(n: usize, s: &Vec<char>, is_upper: bool) -> Vec<usize> {",
      "        let mut hash_values = vec![0; n + 1];",
      "        let base = if is_upper { 0x40 } else { 0x60 };",
      "        for i in 0..n {",
      "            hash_values[i + 1] = (hash_values[i] * 100 + (s[i] as u8 - base) as usize) % HASH_MOD;",
      "        }",
      "        hash_values",
      "    }",
      "",
      "    // 1-indexed で 累積ハッシュ値から[l, r] の区間のハッシュ値を取得する",
      "    fn get_hash(&self, l: usize, r: usize, hash: &Vec<usize>) -> usize {",
      "        let from = l - 1;",
      "        let to = r;",
      "        let right = (hash[to] + HASH_MOD) % HASH_MOD;",
      "        let left = (self.power[to - from] * hash[from]) % HASH_MOD;",
      "        (right + HASH_MOD - left) % HASH_MOD",
      "    }",
      "",
      "    // 元の文字列の[l, r] の区間が回文かどうかを判定する",
      "    #[allow(unused)]",
      "    fn is_hash_correct_kaibun(&self, lindex: usize, rindex: usize, n: usize) -> bool ",
      "    {",
      "        // 元の文字列のハッシュ",
      "        let left = self.get_hash(lindex, rindex, &self.hash_values);",
      "        let right = self.get_hash(n+1-rindex, n+1-lindex, &self.rev_hash_values);",
      "        left == right",
      "    }",
      "}"
    ]
  }
}
