{
  "FenwickTree": {
    "prefix": "FenwickTree",
    "body": [
      "struct FenwickTree {",
      "    n: usize,",
      "    data: Vec<i64>,",
      "}",
      "",
      "impl FenwickTree {",
      "    // サイズ `n` で初期化",
      "    fn new(n: usize, init_val: i64) -> Self {",
      "        Self {",
      "            n,",
      "            data: vec![init_val; n + 1],",
      "        }",
      "    }",
      "",
      "    // `i` 番目の要素（0-indexed）に `x` を加算する",
      "    fn add(&mut self, mut i: usize, x: i64) {",
      "        i += 1; // 内部で 1-indexed に変換",
      "        while i <= self.n {",
      "            self.data[i] += x;",
      "            i += i & i.wrapping_neg(); // LSB (Least Significant Bit) を加算",
      "        }",
      "    }",
      "",
      "    // [0, i) の範囲の合計を求める（0-indexed）",
      "    #[allow(unused)]",
      "    fn sum(&self, mut i: usize) -> i64 {",
      "        let mut s = 0;",
      "        while i > 0 {",
      "            s += self.data[i];",
      "            i -= i & i.wrapping_neg(); // LSB を減算",
      "        }",
      "        s",
      "    }",
      "",
      "    // [l, r) の範囲の合計を求める（0-indexed）",
      "    #[allow(unused)]",
      "    fn range_sum(&self, l: usize, r: usize) -> i64 {",
      "        self.sum(r) - self.sum(l)",
      "    }",
      "",
      "    // 累積和が w 以上になる最小のインデックス i を返す(単調増加が前提)",
      "    // (0-indexed の i を返す。全ての合計が w 未満なら n を返す)",
      "    #[allow(unused)]",
      "    fn lower_bound(&self, mut w: i64) -> usize {",
      "        if w <= 0 {",
      "            return 0;",
      "        }",
      "        let mut i = 0;",
      "        // n 以下の最大の2のべき乗から始める",
      "        let mut k = self.n.next_power_of_two();",
      "        ",
      "        while k > 0 {",
      "            if i + k <= self.n && self.data[i + k] < w {",
      "                w -= self.data[i + k];",
      "                i += k;",
      "            }",
      "            k >>= 1;",
      "        }",
      "        i // ここでは sum(i) < w かつ sum(i+1) >= w となる i が求められる",
      "    }",
      "",
      "    #[allow(unused)]",
      "    fn debug_print(&self) {",
      "        for i in 0..self.n {",
      "            print!(\"{} \", self.range_sum(i, i+1));",
      "        }",
      "        println!();",
      "    }",
      "}",

    ]
  }
}
