{
  "compressor": {
    "prefix": "compressor",
    "body": [
      "// 座標圧縮構造体",
      "#[allow(unused)]",
      "// origin_mp: 元の値 → 圧縮後インデックス",
      "// compress_mp: 圧縮後インデックス → 元の値",
      "// sindex: 初めのインデックス",
      "struct Compressor {",
      "    origin_mp: HashMap<usize, usize>,",
      "    compress_mp: HashMap<usize, usize>,",
      "    _sindex: usize,",
      "}",
      "impl Compressor {",
      "    // 初期化(新しい座標圧縮構造体を作る)",
      "    pub fn new(bset: &BTreeSet<usize>, sindex: usize) -> Self {",
      "        let mut origin_mp = HashMap::new();",
      "        let mut compress_mp = HashMap::new();",
      "        let mut i = sindex;",
      "        // BTreeSetをイテレートし、1つずつ圧縮インデックスを割り振る",
      "        for &item in bset {",
      "            origin_mp.insert(item, i);",
      "            compress_mp.insert(i, item);",
      "            i += 1;",
      "        }",
      "        Compressor { origin_mp, compress_mp, _sindex: sindex }",
      "    }",
      "    // 元の値から圧縮後のインデックスを取得する。",
      "    // 値が存在しない場合はINVALID_VALUEを返す。",
      "    #[allow(unused)]",
      "    pub fn compress(&mut self, origin_value: usize) -> usize {",
      "        match self.origin_mp.get(&origin_value) {",
      "            Some(&compress_index) => compress_index,",
      "            None => INVALID_VALUE,",
      "        }",
      "    }",
      "    // 圧縮後のインデックスから元の値を取得する。",
      "    // 値が存在しない場合はINVALID_VALUEを返す。",
      "    #[allow(unused)]",
      "    pub fn decompress(&mut self, compress_index: usize) -> usize {",
      "        match self.compress_mp.get(&compress_index) {",
      "            Some(&origin_value) => origin_value,",
      "            None => INVALID_VALUE,",
      "        }",
      "    }",
      "}",
      "// 値が見つからなかったとき用の値",
      "const INVALID_VALUE: usize = 1 << 60;",
    ]
  }
}
