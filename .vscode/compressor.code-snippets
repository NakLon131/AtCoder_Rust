{
  "compressor": {
    "prefix": "compressor",
    "body": [
      "// 座標圧縮",
      "#[allow(unused)]",
      "struct Compressor {",
      "    bmp: BTreeMap<usize, usize>,    // bmp[key] = idx",
      "    vec: Vec<usize>,                // vec[idx] = key",
      "    sz: usize",
      "}",
      "impl Compressor {",
      "    // 初期化",
      "    pub fn new(bset: &BTreeSet<usize>) -> Self {",
      "        let mut bmp = BTreeMap::new();",
      "        let mut vec = Vec::new();",
      "        let mut sz = 0;",
      "        for &item in bset {",
      "            bmp.insert(item, sz);",
      "            vec.push(item);",
      "            sz += 1;",
      "        }",
      "        Compressor { bmp, vec, sz}",
      "    }",
      "",
      "    #[allow(unused)]",
      "    pub fn get_idx_bykey(&mut self, key: usize) -> usize {",
      "        match self.bmp.get(&key) {",
      "            Some(&idx) => idx,",
      "            None => INVALID_VALUE,",
      "        }",
      "    }",
      "    #[allow(unused)]",
      "    pub fn get_key_byidx(&mut self, idx: usize) -> usize {",
      "        match idx < self.sz {",
      "            true => self.vec[idx],",
      "            false => INVALID_VALUE,",
      "        }",
      "    }",
      "    #[allow(unused)]",
      "    pub fn dbg_compressor(&mut self) {",
      "        for idx in 0..self.sz {",
      "            println!(\"idx:{} key:{}\", idx, self.vec[idx]);",
      "        }",
      "    }",
      "}",
      "// 値が見つからなかったとき用の値",
      "const INVALID_VALUE: usize = 1 << 60;",
    ]
  },
