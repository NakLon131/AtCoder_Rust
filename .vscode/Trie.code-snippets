{
  "Trie": {
    "prefix": "Trie",
    "body": [
      "struct Trie{",
      "    cur_prefix_cnt: Vec<usize>,             // 自ノードの接頭辞の数:0番目はダミー",
      "    next_nodes: Vec<HashMap<char, usize>>,  // ノード:[次ノードの文字] = 次ノードindex",
      "}",
      "impl Trie {",
      "    fn new() -> Self {",
      "        Trie {",
      "            cur_prefix_cnt: vec![0; 1],",
      "            next_nodes: vec![HashMap::new()], ",
      "        }",
      "    }",
      "",
      "    // 接頭辞追加",
      "    fn add_string(&mut self, s: &str) -> usize{",
      "        let mut cur = 0;",
      "        for c in s.chars() {",
      "            // 登録済みの次ノードに遷移",
      "            if let Some(&next) = self.next_nodes[cur].get(&c) {",
      "                self.cur_prefix_cnt[next] += 1;",
      "                cur = next;",
      "            }",
      "            // 次ノードが未登録の場合は、メモリ確保してから遷移",
      "            else {",
      "                let next = self.__regist_next_node(cur, c);",
      "                self.cur_prefix_cnt[next] += 1;",
      "                cur = next;",
      "            }",
      "        }",
      "        cur",
      "    }",
      "    // 次ノードのメモリ確保",
      "    fn __regist_next_node(&mut self, cur: usize, c: char) -> usize {",
      "        let next = self.get_sz();",
      "        self.next_nodes.push(HashMap::new());",
      "        self.next_nodes[cur].insert(c, next);",
      "        self.cur_prefix_cnt.push(0);",
      "        next",
      "    }",
      "    // trie木のサイズを取得",
      "    fn get_sz(&mut self) -> usize {",
      "        self.next_nodes.len()",
      "    }",
      "",
      "    // ノードで持っている接頭辞の個数を取得",
      "    #[allow(unused)]",
      "    fn get_prefix_cnt(&mut self, idx: usize) -> usize {",
      "        self.cur_prefix_cnt[idx]",
      "    }",
      "",
      "    // 文字列を探索して、LCP(最長共通接頭辞)を取得",
      "    #[allow(unused)]",
      "    fn get_lcp_cnt(&mut self, s: &str) -> usize {",
      "        let mut cur = 0;",
      "        let mut ret = 0;",
      "        for c in s.chars() {",
      "            if let Some(&next) = self.next_nodes[cur].get(&c) {",
      "                if self.cur_prefix_cnt[next] < 2 {",
      "                    return ret;",
      "                }",
      "                ret += 1;",
      "                cur = next;",
      "            }",
      "        }",
      "        ret",
      "    }",
      "}",
    ]
  }
}
