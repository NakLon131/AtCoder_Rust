  "UnionFindBySize": {
    "prefix": "UnionFindBySize",
    "body": [
      "#[allow(unused)]",
      "struct UnionFindBySize {",
      "    verb: usize,        // 頂点数",
      "    g_size: Vec<usize>,   // 各頂点のグラフサイズ",
      "    g_parent: Vec<isize>, // 親情報",
      "    pass_cmp: bool,     // 経路圧縮の有無",
      "}",
      "impl UnionFindBySize {",
      "    // 経路圧縮は親の情報をメモ化する。",
      "    // Union-by-sizeはサイズの大きいに小さい方を取り込む。マージテク",
      "    fn new(n : usize, pass_cmp: bool) -> Self {",
      "        UnionFindBySize { verb: n, g_size : vec![1; n], g_parent : vec![-1; n], pass_cmp }",
      "    }",
      "    // 代表値を求める。(経路圧縮も行う)",
      "    #[allow(unused)]",
      "    fn find(&mut self, u: usize) -> usize {",
      "        let mut mut_u = u;",
      "        if self.g_parent[mut_u] == -1 { return mut_u; }",
      "",
      "        let p = self.g_parent[mut_u] as usize;",
      "",
      "        // 最適化あり",
      "        if self.pass_cmp {",
      "            // 経路圧縮あり = xの親parent[u]を根に付け替える",
      "            let par = self.find(p);",
      "            self.g_parent[mut_u] = par as isize;",
      "            return self.g_parent[mut_u] as usize;",
      "        }",
      "        // 最適化なし",
      "        else {",
      "            // 経路圧縮無し = 根の番号を返すだけ",
      "            return self.find(p)",
      "        }        ",
      "    }",
      "    // 併合",
      "    fn merge(&mut self, u: usize, v: usize) -> bool {",
      "        // 代表値を取得",
      "        let mut x = self.find(u);",
      "        let mut y = self.find(v);",
      "        // 既に同じ集合",
      "        if x == y { return false; }",
      "",
      "        // 木のサイズが小さいものを大きいものに最適化して併合(Union by g_size)",
      "        if self.g_size[x] < self.g_size[y] {",
      "            swap(&mut x, &mut y);",
      "        }",
      "",
      "        // xが親となる",
      "        self.g_parent[y] = x as isize;",
      "        self.g_size[x] += self.g_size[y];",
      "        true",
      "    }",
      "    // 同じ集合かどうかを判定",
      "    #[allow(unused)]",
      "    fn is_same(&mut self, u: usize, v: usize) -> bool {",
      "        self.find(u) == self.find(v)",
      "    }",
      "    // 集合のサイズを取得",
      "    #[allow(unused)]",
      "    fn get_group_size(&mut self, u: usize) -> usize {",
      "        let x = self.find(u);",
      "        self.g_size[x]",
      "    }",
      "    // 各頂点の親を出力",
      "    #[allow(unused)]",
      "    fn dbg_parent(&mut self) {",
      "        for idx in 0..self.g_size.len() {",
      "            if self.g_parent[idx] == -1 { println!(\"verb[{}] is root\", idx); } ",
      "            else { println!(\"verb[{}] g_parent:{}\", idx, self.g_parent[idx]); }",
      "        }",
      "    }",
      "    // 各頂点のサイズを出力",
      "    #[allow(unused)]",
      "    fn dbg_group_size(&mut self) {",
      "        for idx in 0..self.g_size.len() {",
      "            if self.g_parent[idx] != -1 { println!(\"verb[{}] is not root\", idx); } ",
      "            else { println!(\"verb[{}] group_size:{}\", idx, self.get_group_size(idx)); } ",
      "        }",
      "    }",
      "}",
    ]
  },
  "UnionFindByRank": {
    "prefix": "UnionFindByRank",
    "body": [
      "struct UnionFindByRank {",
      "    rank: Vec<usize>,          // 各頂点のグラフサイズ",
      "    parent: Vec<isize>,        // 親情報",
      "    pass_cmp: bool,            // 経路圧縮の有無",
      "    ubr : bool,                // Union-by-rankの有無",
      "}",
      "impl UnionFindByRank {",
      "    // 経路圧縮は親の情報をメモ化する。",
      "    // Union-by-rankは、深さの大きいに小さい方を取り込む。",
      "    fn new(n : usize, pass_cmp: bool, ubr: bool) -> Self {",
      "        UnionFindByRank { rank : vec![0; n], parent : vec![-1; n], pass_cmp, ubr }",
      "    }",
      "    // 代表値を求める。(経路圧縮も行う)",
      "    #[allow(unused)]",
      "    fn find(&mut self, u: usize) -> usize {",
      "        let mut mut_u = u;",
      "        if self.parent[mut_u] == -1 { return mut_u; }",
      "",
      "        let p = self.parent[mut_u] as usize;",
      "",
      "        // 最適化あり",
      "        if self.pass_cmp {",
      "            // 経路圧縮あり = xの親parent[u]を根に付け替える",
      "            let par = self.find(p);",
      "            self.parent[mut_u] = par as isize;",
      "            return self.parent[mut_u] as usize;",
      "        }",
      "        // 最適化なし",
      "        else {",
      "            // 経路圧縮無し = 根の番号を返すだけ",
      "            return self.find(p)",
      "        }        ",
      "    }",
      "    // 併合",
      "    fn merge(&mut self, u: usize, v: usize) -> bool {",
      "        // 代表値を取得",
      "        let mut x = self.find(u);",
      "        let mut y = self.find(v);",
      "        // 既に同じ集合",
      "        if x == y { return false; }",
      "",
      "        if self.ubr {",
      "            // 最適化あり",
      "            // 木の深さが小さいものを大きいものに併合(Union by rank)",
      "            if self.rank[x] < self.rank[y] {",
      "                swap(&mut x, &mut y);",
      "            }",
      "        }",
      "        // yをxの子とする",
      "        self.parent[y] = x as isize;",
      "        self.rank[x] += 1;",
      "        true",
      "    }",
      "    // 同じ集合かどうかを判定",
      "    #[allow(unused)]",
      "    fn same(&mut self, u: usize, v: usize) -> bool {",
      "        self.find(u) == self.find(v)",
      "    }",
      "    // 集合のサイズを求める",
      "    #[allow(unused)]",
      "    fn rank(&mut self, u: usize) -> usize {",
      "        let x = self.find(u);",
      "        self.rank[x]",
      "    }",
      "}",
    ]
  },
  "UnionFind": {
    "prefix": "UnionFind",
    "body": [
      "// Union-Find構造体",
      "#[allow(unused)]",
      "struct UnionFind {",
      "    verb: usize, // 頂点数",
      "    g_size: Vec<usize>,  // 各頂点の集合サイズ",
      "    g_parent: Vec<isize>,      // 親情報",
      "}",
      "",
      "impl UnionFind {",
      "    // 初期化",
      "    fn new(n: usize) -> Self {",
      "        UnionFind { verb: n, g_size: vec![1; n], g_parent: vec![-1; n] }",
      "    }",
      "",
      "    // 代表元を求める",
      "    fn find(&mut self, u: usize) -> usize {",
      "        if self.g_parent[u] == -1 {",
      "            return u;",
      "        }",
      "        let p = self.g_parent[u] as usize;",
      "        let root = self.find(p);",
      "        // 経路圧縮",
      "        self.g_parent[u] = root as isize;",
      "        root",
      "    }",
      "",
      "    // 2つの集合を併合",
      "    fn merge(&mut self, u: usize, v: usize) -> bool {",
      "        let mut x = self.find(u);",
      "        let mut y = self.find(v);",
      "        if x == y {",
      "            // 既に同じ集合",
      "            return false; ",
      "        }",
      "        if self.g_size[x] < self.g_size[y] {",
      "            swap(&mut x, &mut y);",
      "        }",
      "        self.g_parent[y] = x as isize;",
      "        self.g_size[x] += self.g_size[y];",
      "        true",
      "    }",
      "",
      "    // 同じ集合かどうかを判定",
      "    #[allow(unused)]",
      "    fn is_same(&mut self, u: usize, v: usize) -> bool {",
      "        self.find(u) == self.find(v)",
      "    }",
      "",
      "    #[allow(unused)]",
      "    // 集合のサイズを取得",
      "    fn get_group_size(&mut self, u: usize) -> usize {",
      "        let root = self.find(u);",
      "        self.g_size[root]",
      "    }",
      "}",
    ]
  },
