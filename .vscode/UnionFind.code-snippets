  "UnionFindBySize": {
    "prefix": "UnionFindBySize",
    "body": [
      "struct UnionFindBySize {",
      "    size: Vec<usize>,          // 各頂点のグラフサイズ",
      "    parent: Vec<isize>,        // 親情報",
      "    pass_cmp: bool,            // 経路圧縮の有無",
      "    ubs : bool,                // Union-by-sizeの有無",
      "}",
      "impl UnionFindBySize {",
      "    // 経路圧縮は親の情報をメモ化する。",
      "    // Union-by-sizeはサイズの大きいに小さい方を取り込む。マージテク",
      "    fn new(n : usize, pass_cmp: bool, ubs: bool) -> Self {",
      "        UnionFindBySize { size : vec![1; n], parent : vec![-1; n], pass_cmp, ubs }",
      "    }",
      "    // 代表値を求める。(経路圧縮も行う)",
      "    #[allow(unused)]",
      "    fn find(&mut self, u: usize) -> usize {",
      "        let mut mut_u = u;",
      "        if self.parent[mut_u] == -1 { return mut_u; }",
      "",
      "        let p = self.parent[mut_u] as usize;",
      "",
      "        // 最適化あり",
      "        if self.pass_cmp {",
      "            // 経路圧縮あり = xの親parent[u]を根に付け替える",
      "            let par = self.find(p);",
      "            self.parent[mut_u] = par as isize;",
      "            return self.parent[mut_u] as usize;",
      "        }",
      "        // 最適化なし",
      "        else {",
      "            // 経路圧縮無し = 根の番号を返すだけ",
      "            return self.find(p)",
      "        }        ",
      "    }",
      "    // 併合",
      "    fn merge(&mut self, u: usize, v: usize) -> bool {",
      "        // 代表値を取得",
      "        let mut x = self.find(u);",
      "        let mut y = self.find(v);",
      "        // 既に同じ集合",
      "        if x == y { return false; }",
      "",
      "        if self.ubs {",
      "            // 最適化あり",
      "            // 木のサイズが小さいものを大きいものに併合(Union by size)",
      "            if self.size[x] < self.size[y] {",
      "                swap(&mut x, &mut y);",
      "            }",
      "        }",
      "        else {",
      "            // 最適化なしの場合は不定なので注意。",
      "            // 呼び出し元で指定した場合、代表値で指定した場合で結果がそれぞれ変わる",
      "            if x < y { swap(&mut x, &mut y);}",
      "        }",
      "        // xが親となる",
      "        self.parent[y] = x as isize;",
      "        self.size[x] += self.size[y];",
      "        true",
      "    }",
      "    // 同じ集合かどうかを判定",
      "    #[allow(unused)]",
      "    fn same(&mut self, u: usize, v: usize) -> bool {",
      "        self.find(u) == self.find(v)",
      "    }",
      "    // 集合のサイズを求める",
      "    #[allow(unused)]",
      "    fn size(&mut self, u: usize) -> usize {",
      "        let x = self.find(u);",
      "        self.size[x]",
      "    }",
      "    // 各頂点の親を出力",
      "    #[allow(unused)]",
      "    fn dbg_parent(&mut self) {",
      "        for idx in 0..self.size.len() {",
      "            if self.parent[idx] == -1 { println!(\"verb[{}] is root\", idx); } ",
      "            else { println!(\"verb[{}] parent:{}\", idx, self.parent[idx]); }",
      "        }",
      "    }",
      "    // 各頂点のサイズを出力",
      "    #[allow(unused)]",
      "    fn dbg_group_size(&mut self) {",
      "        for idx in 0..self.size.len() {",
      "            println!(\"verb[{}] group_size:{}\", idx, self.size(idx));",
      "        }",
      "    }",
      "}",
    ]
  },
