  "divisor": {
    "prefix": "divisor",
    "body": [
      "pub fn divisor(n: usize) -> Vec<usize> {",
      "    // 約数列挙",
      "    let mut ret = Vec::new();",
      "    let mut i = 1;",
      "    while i * i <= n {",
      "        if n % i == 0 {",
      "            ret.push(i);",
      "            if n / i != i {",
      "                ret.push(n / i);",
      "            }",
      "        }",
      "        i += 1;",
      "    }",
      "    ret.sort();",
      "    ret",
      "}"
    ]
  }
}
