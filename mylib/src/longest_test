use cargo_snippet::snippet;
use std::cmp::min;
use std::cmp::max;

#[snippet]
// 最長距離の構造体
// from-toと最長距離を返す
#[allow(unused)]
struct LongPath {
	from : usize,
	to : usize,
	dist: usize
}
// dfsで最長パスを求める
// 引数：cpos: 現在位置,ppos: ひとつ前の位置, weight_edge: 重み付きの辺, cdist: 現在の距離
// 戻り値: (最長距離, 最も遠い位置)
fn tree_dfs(cpos: usize, ppos: usize, weight_edge: &Vec<Vec<(usize, usize)>>, cdist: usize) -> (usize, usize) {
	// 位置と距離を返す
	let mut ret  = (cdist, cpos);	
	for &npos in &weight_edge[cpos] {
		// 後戻り禁止
		if npos.1 == ppos { continue; } 
		// 最長距離, 最も遠い位置を更新
		ret = max(ret, tree_dfs(npos.1, cpos, weight_edge, cdist + npos.0));
	}
	ret
}
// グラフの最長距離を求める 木の直径
fn longest_path(weight_edge: &Vec<Vec<(usize, usize)>>) -> LongPath {
	// 1回目実行で、最も遠い位置を見つける
	let far_info = tree_dfs(0, 1 << 30, weight_edge, 0);
	// 2回目実行で、最も遠い位置からの最長距離を見つける
	let longest_info = tree_dfs(far_info.1, 1 << 30, weight_edge, 0);
	LongPath {from: far_info.1, to: longest_info.1, dist: longest_info.0}
}

#[cfg(test)]
mod tests {
    // use super::*;

    use std::mem::swap;

    use crate::longest_path;

    #[test]
    fn test1(){
        // 頂点情報: 0 - 1 - 2 - 3
        // 重みは全て1
        let mut edge = vec![Vec::new(); 4];
        edge[0].push((1,1)); edge[1].push((1,0));
        edge[1].push((1,2)); edge[2].push((1,1));
        edge[2].push((1,3)); edge[3].push((1,2));
        let info = longest_path(&edge);
        assert_eq!(3, info.dist);
    }
    #[test]
    fn test2(){
        // 頂点情報: 0 - 1 - 2 - 3
        // 重み:       3   5   7
        let mut edge = vec![Vec::new(); 4];
        edge[0].push((3,1)); edge[1].push((3,0));
        edge[1].push((5,2)); edge[2].push((5,1));
        edge[2].push((7,3)); edge[3].push((7,2));
        let info = longest_path(&edge);
        assert_eq!(15, info.dist);
    }
    #[test]
    fn test3(){
        //             3   5  
        // 頂点情報: 0 - 1 - 2
        // 頂点情報:     1 - 3
        // 重み:           7
        let mut edge = vec![Vec::new(); 4];
        edge[0].push((3,1)); edge[1].push((3,0));
        edge[1].push((5,2)); edge[2].push((5,1));
        edge[1].push((7,3)); edge[3].push((7,1));

        let info = longest_path(&edge);       
        let mut x = info.from;
        let mut y = info.to;
        swap(&mut x, &mut y);

        assert_eq!(12, info.dist);
        assert_eq!(2, x);
        assert_eq!(3, y);
    }

}

