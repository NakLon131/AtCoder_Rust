use cargo_snippet::snippet;

#[snippet]
pub fn ranglen(arr: &Vec<char>) -> Vec<(char, usize)>{
    let len = arr.len();
    let mut arr_ret = Vec::new();
   
    let mut tail = 0;
    let mut top = 0;
    while tail < len {
        let now_c = arr[tail];

        while top < len && now_c == arr[top] { top += 1; }
        arr_ret.push((now_c, top - tail));

        tail = top;
    }
    arr_ret
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test1(){
        let arr: Vec<char> = "aaabbca".chars().collect();
        let rang_arr = ranglen(&arr);

        assert_eq!(rang_arr[0].0, 'a');
        assert_eq!(rang_arr[0].1, 3);
        assert_eq!(rang_arr[1].0, 'b');
        assert_eq!(rang_arr[1].1, 2);
        assert_eq!(rang_arr[2].0, 'c');
        assert_eq!(rang_arr[2].1, 1);
        assert_eq!(rang_arr[3].0, 'a');
        assert_eq!(rang_arr[3].1, 1);
    }
}