use cargo_snippet::snippet;

#[snippet]
pub fn rotate_img(h: usize, w: usize, s: &Vec<Vec<char>>) -> Vec<Vec<char>>{
    // 画像回転
    let mut ret = vec![vec!['.'; h]; w];
    for i in 0..h {
        for j in 0..w {
            ret[j][h-1-i] = s[i][j];
        }
    }
    ret
}

