use cargo_snippet::snippet;

#[snippet]
struct LCATree {
	n: usize,							// ノード数
	logn: usize,						// 二分探索のため、最大階層数
	depth: Vec<usize>,					// 各ノードの深さ
	distance: Vec<usize>,				// 各ノードまでの距離
	ancestor: Vec<Vec<usize>>,			// 祖先テーブル[k][i] = 2^k番目の祖先のノードi　ない場合はINF
	edges: Vec<Vec<(usize, usize)>>		// 隣接リストの辺の情報
}
const INFS : usize = 1 << 60;
impl LCATree {
	// 初期化
	fn new(n: usize) -> Self {
		let logn = ((n as f64).log2().ceil() as usize) + 1;
		LCATree {n, logn, depth: vec![0; n], distance: vec![0; n], ancestor: vec![vec![INFS; n]; logn], edges: vec![vec![]; n]}
	}
	// 辺の追加(無向グラフ)
	fn add_edge(&mut self, u: usize, v: usize, w: usize) {
		self.edges[u].push((v, w));
		self.edges[v].push((u, w));
	}
	// 祖先テーブルの構築
	fn build(&mut self, root: usize) {
		// 祖先テーブルの初期化(一つ上の祖先を埋める)
		let mut stack = vec![root];
		while let Some(cur) = stack.pop() {
			for &(nxt, w) in &self.edges[cur] {
				// 子ノードの祖先がまだ設定されていない、かつ子ノードがルートでない場合に処理を行う。
				if self.ancestor[0][nxt] == INFS && nxt != root {
					self.ancestor[0][nxt] = cur;
					self.depth[nxt] = self.depth[cur] + 1;
					self.distance[nxt] = self.distance[cur] + w;
					stack.push(nxt);
				}
			}
		}
		// 祖先テーブルの構築(二階層以上上の祖先を順番に埋める)
		for k in 1..self.logn {
			for i in 0..self.n {
				// 祖先が存在する場合
				if self.ancestor[k-1][i] != INFS {
					let prev_ancestor = self.ancestor[k-1][i] as usize;
					self.ancestor[k][i] = self.ancestor[k-1][prev_ancestor];
				}
				else {
					self.ancestor[k][i] = INFS;
				}
			}
		}
	}
	// 祖先テーブルを求める
	fn lca(&self, mut u: usize, mut v: usize) -> usize {
		if self.depth[u] > self.depth[v] {
			std::mem::swap(&mut u, &mut v);
		}
		// 階層の差分を見て、深い方を上の階層に移動させる
		for k in (0..self.logn).rev() {
			if self.depth[v] - self.depth[u] >= 1 << k {
				if let Some(ancestor_k) = self.ancestor[k].get(v) {
					if *ancestor_k != INFS {
						v = *ancestor_k as usize;
					}
				}
			}
		}
		// 2つの場所が一致
		if u == v { return u;}
		// 一致しない場合は、一致しない部分でそれぞれ1階層ずつ上げる。
		for k in (0..self.logn).rev() {
			if self.ancestor[k][u] != INFS && self.ancestor[k][u] != self.ancestor[k][v] {
				u = self.ancestor[k][u] as usize;
				v = self.ancestor[k][v] as usize;
			}
		}
		self.ancestor[0][u] as usize
	}
}

#[cfg(test)]
mod tests {
    // use super::*;
    use crate::LCATree;
    #[test]
    fn test1(){
        let n = 13;
        let ab = vec![(0, 1), (0, 2), (1, 3), (1, 4), (2, 5), (4, 6), (4, 7), (6, 8), (7, 9), (9, 10), (9, 12), (11, 12)];
        
        // 最小共通祖先
        let mut tree = LCATree::new(n);
        for &(a, b) in &ab {
            tree.add_edge(a, b, 1);
        }
        tree.build(0);

        assert_eq!(4, tree.lca(6, 9)); // 下位層を上に移動
        assert_eq!(0, tree.lca(3, 5)); // 下位層を上に移動、さらに移動が必要。
    }
}

