use cargo_snippet::snippet;

#[snippet]
// [a,b] ~ (c,d) の面積
pub fn calc_square_area(a: i64, b: i64, c: i64, d: i64) -> i64 {
	calc_area(c, d) + calc_area(a, b) - calc_area(a, d) - calc_area(c, b)
}

